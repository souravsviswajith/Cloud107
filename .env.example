# Existing Gemini integration (optional)
GEMINI_API_KEY=""

# Optional GLM-5.2 gateway. No provider is enabled without a key.
GLM_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
GLM_MODEL="glm-5.2"
# Set real provider prices before relying on monetary budget enforcement.
GLM_INPUT_USD_PER_MILLION="0"
GLM_OUTPUT_USD_PER_MILLION="0"

# Optional OpenAI-compatible fallback; only used if listed in AI_PROVIDER_ORDER.
AI_FALLBACK_API_KEY=""
AI_FALLBACK_BASE_URL="https://api.openai.com/v1"
AI_FALLBACK_MODEL="gpt-4.1-mini"
AI_FALLBACK_INPUT_USD_PER_MILLION="0"
AI_FALLBACK_OUTPUT_USD_PER_MILLION="0"
AI_PROVIDER_ORDER="glm"
AI_PROVIDER_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="2048"
AI_DAILY_BUDGET_USD="0.25"
AI_REQUEST_BUDGET_USD="0.05"

# APP_URL: URL where this applet is hosted.
APP_URL=""

# PostgreSQL
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="my_db"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Cloud107 auth secret: replace with a cryptographically random secret.
C107_AUTH_SECRET="replace-with-a-long-random-secret"
